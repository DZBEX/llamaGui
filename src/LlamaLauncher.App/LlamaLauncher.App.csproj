<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>LlamaLauncher</AssemblyName>
    <RootNamespace>LlamaLauncher.App</RootNamespace>
    <ApplicationIcon>Assets\LlamaLauncher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LlamaLauncher.Application\LlamaLauncher.Application.csproj" />
    <ProjectReference Include="..\LlamaLauncher.Infrastructure\LlamaLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\LlamaLauncher.Domain\LlamaLauncher.Domain.csproj" />
    <ProjectReference Include="..\LlamaLauncher.Contracts\LlamaLauncher.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <!-- 应用图标：ApplicationIcon 写入 exe（资源管理器/快捷方式/安装包），Resource 供 WPF 窗口与托盘加载 -->
  <ItemGroup>
    <Resource Include="Assets\LlamaLauncher.ico" />
  </ItemGroup>
  <!-- 移除 WinForms SDK 注入的隐式 using，避免与 WPF 类型（UserControl/Color 等）产生歧义 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
