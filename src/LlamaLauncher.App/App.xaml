<Application
    x:Class="LlamaLauncher.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LlamaLauncher.App.Converters"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
            <converters:StateToBrushConverter x:Key="StateToBrush" />
            <converters:MessageStatusToBrushConverter x:Key="MessageStatusToBrush" />
            <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:NullToBoolConverter x:Key="NullToBoolIndeterminate" />
            <converters:LabPageTemplateSelector x:Key="LabPageTemplateSelector" />
            <converters:NodeRunStateToBrushConverter x:Key="NodeRunStateToBrush" />
            <converters:RunStateIconConverter x:Key="RunStateIcon" />
            <converters:DiffKindToBrushConverter x:Key="DiffKindToBrush" />
            <converters:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibility" />
            <converters:EmptyToNullConverter x:Key="EmptyToNull" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
