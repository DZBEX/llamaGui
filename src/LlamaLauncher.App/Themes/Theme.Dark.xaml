<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="App.Color.Background">#FF1B1D21</Color>
    <Color x:Key="App.Color.Surface">#FF232629</Color>
    <Color x:Key="App.Color.SurfaceAlt">#FF2B2F33</Color>
    <Color x:Key="App.Color.Border">#FF3A3F45</Color>
    <Color x:Key="App.Color.TextPrimary">#FFE8EAED</Color>
    <Color x:Key="App.Color.TextSecondary">#FFAAB0B8</Color>
    <Color x:Key="App.Color.Accent">#FF4C8DFF</Color>

    <SolidColorBrush x:Key="App.Window.Background" Color="{StaticResource App.Color.Background}" />
    <SolidColorBrush x:Key="App.Surface" Color="{StaticResource App.Color.Surface}" />
    <SolidColorBrush x:Key="App.Surface.Alt" Color="{StaticResource App.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="App.Border" Color="{StaticResource App.Color.Border}" />
    <SolidColorBrush x:Key="App.Text.Primary" Color="{StaticResource App.Color.TextPrimary}" />
    <SolidColorBrush x:Key="App.Text.Secondary" Color="{StaticResource App.Color.TextSecondary}" />
    <SolidColorBrush x:Key="App.Accent" Color="{StaticResource App.Color.Accent}" />

    <!--  聊天消息气泡  -->
    <SolidColorBrush x:Key="App.Chat.UserBubble" Color="#FF2C3B58" />
    <SolidColorBrush x:Key="App.Chat.UserBubbleBorder" Color="#FF40598A" />
    <SolidColorBrush x:Key="App.Chat.AssistantBubble" Color="{StaticResource App.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="App.Chat.AssistantBubbleBorder" Color="{StaticResource App.Color.Border}" />
    <SolidColorBrush x:Key="App.Chat.AvatarBackground" Color="#FF343A41" />

    <!--  滚动条（细胶囊滑块；Alpha 越低越淡，深浅主题各自调色）  -->
    <SolidColorBrush x:Key="App.Scroll.Thumb" Color="#59A9B2BD" />
    <SolidColorBrush x:Key="App.Scroll.ThumbHover" Color="#8FB8C0CC" />
    <SolidColorBrush x:Key="App.Scroll.ThumbDragging" Color="#C4CBD5E1" />
</ResourceDictionary>
