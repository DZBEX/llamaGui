<Window x:Class="LlamaLauncher.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Window.Background}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   Foreground="{DynamicResource App.Text.Primary}"
                   TextWrapping="Wrap" />

        <TextBox x:Name="InputBox"
                 Grid.Row="1"
                 Margin="0,10,0,0"
                 Padding="6,4"
                 FontFamily="Consolas" />

        <TextBlock x:Name="ConfirmHint"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource App.Text.Secondary}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button MinWidth="96" Margin="0,0,10,0" Click="OnCancelClick" Content="取消" />
            <Button x:Name="OkButton"
                    MinWidth="120"
                    Click="OnOkClick"
                    Style="{DynamicResource App.PrimaryButtonStyle}"
                    Content="确定" />
        </StackPanel>
    </Grid>
</Window>
