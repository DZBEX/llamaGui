<Window x:Class="LlamaLauncher.App.Dialogs.InstanceCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/LlamaLauncher.ico"
        Title="新建服务实例"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Window.Background}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="选择启动配置并命名实例："
                   Foreground="{DynamicResource App.Text.Primary}" />

        <ComboBox x:Name="ProfileCombo"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  MinHeight="30" />

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="实例名称（可留空自动生成）："
                   Foreground="{DynamicResource App.Text.Primary}" />

        <TextBox x:Name="NameBox"
                 Grid.Row="3"
                 Margin="0,8,0,0"
                 Padding="6,4" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button MinWidth="96" Margin="0,0,10,0" Click="OnCancelClick" Content="取消" />
            <Button MinWidth="120"
                    Click="OnCreateClick"
                    Style="{DynamicResource App.PrimaryButtonStyle}"
                    Content="创建实例" />
        </StackPanel>
    </Grid>
</Window>
