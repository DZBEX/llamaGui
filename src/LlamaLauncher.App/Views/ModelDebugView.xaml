<UserControl x:Class="LlamaLauncher.App.Views.ModelDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LlamaLauncher.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：服务选择与运行操作 -->
        <Border Grid.Row="0" Style="{DynamicResource App.CardBorder}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="模型服务" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="280"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          VerticalAlignment="Center" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="6,0,0,0" Style="{DynamicResource App.ToolbarButtonStyle}" />
                <TextBlock Text="请求超时（秒）" VerticalAlignment="Center" Margin="14,0,6,0" />
                <TextBox Width="64" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <TextBlock Text="响应上限（KB）" VerticalAlignment="Center" Margin="14,0,6,0" />
                <TextBox Width="70" Text="{Binding MaxResponseKb, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <Button Command="{Binding RunCommand}"
                        AutomationProperties.Name="运行"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                        Margin="14,0,0,0" Style="{DynamicResource App.PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Icon="state-play" Width="12" Height="12" Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="运行" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="取消" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Margin="6,0,0,0" />
                <Button Content="重置" Command="{Binding ResetCommand}" Margin="6,0,0,0" Style="{DynamicResource App.ToolbarButtonStyle}" />
                <TextBlock Text="保存到用例" VerticalAlignment="Center" Margin="14,0,6,0" />
                <ComboBox Width="180" ItemsSource="{Binding WorkflowChoices}"
                          SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                          DisplayMemberPath="Name" VerticalAlignment="Center" />
                <Button Content="保存为测试用例" Command="{Binding SaveAsTestCaseCommand}" Margin="6,0,0,0" Style="{DynamicResource App.ToolbarButtonStyle}" />
            </WrapPanel>
        </Border>

        <!-- 主体：输入 | 输出 -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource App.CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="状态（state）" FontWeight="SemiBold" />
                    <TextBox Grid.Row="1"
                             Text="{Binding StateText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             MinHeight="90"
                             Margin="0,6,0,10" />
                    <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="问题（questions，TypeSafe System One 结构）" FontWeight="SemiBold" />
                        <Button Content="插入 choice" Command="{Binding InsertTemplateCommand}" CommandParameter="choice" Margin="10,0,0,0" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="插入 score" Command="{Binding InsertTemplateCommand}" CommandParameter="score" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="插入 noul" Command="{Binding InsertTemplateCommand}" CommandParameter="noul" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="格式化" Command="{Binding FormatInputsCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="校验" Command="{Binding ValidateInputsCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                    </WrapPanel>
                    <TextBox Grid.Row="3"
                             Text="{Binding QuestionsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             MinHeight="180"
                             Margin="0,0,0,8" />
                    <WrapPanel Grid.Row="4">
                        <Button Content="加载输入…" Command="{Binding LoadFromFileCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="导出输入…" Command="{Binding SaveToFileCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="复制 state" Command="{Binding CopyCommand}" CommandParameter="state" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="复制 questions" Command="{Binding CopyCommand}" CommandParameter="questions" Style="{DynamicResource App.ToolbarButtonStyle}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource App.CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="结构化结果" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MetricsText}" Style="{DynamicResource App.CaptionText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,6">
                        <ItemsControl ItemsSource="{Binding AnswerCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,0,8" Padding="10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding QuestionId}" FontWeight="SemiBold" />
                                                <Border Background="{DynamicResource App.Surface.Alt}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Type}" FontSize="11" Style="{DynamicResource App.SecondaryText}" />
                                                </Border>
                                                <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" Foreground="{DynamicResource App.Accent}" />
                                                <TextBlock Margin="10,0,0,0" FontSize="11"
                                                           Text="{Binding Confidence, StringFormat=置信度 {0:P1}}"
                                                           Style="{DynamicResource App.SecondaryText}"
                                                           Visibility="{Binding Confidence, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Bars}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasBars, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="64" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                            <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="100"
                                                                         Value="{Binding Percent, Mode=OneWay}"
                                                                         Background="{DynamicResource App.Surface.Alt}"
                                                                         Foreground="{DynamicResource App.Accent}"
                                                                         VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Margin="6,0,0,0" FontSize="12"
                                                                       HorizontalAlignment="Right" Style="{DynamicResource App.SecondaryText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,2,0,6">
                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource App.State.Error}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorText, Converter={StaticResource NullOrEmptyToVisibility}}" />
                        <TextBlock Text="{Binding ErrorHint}" TextWrapping="Wrap" FontSize="12"
                                   Style="{DynamicResource App.SecondaryText}"
                                   Visibility="{Binding ErrorHint, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="原始响应" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <TextBox Grid.Row="4"
                             Text="{Binding RawResponseText}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                    <Button Grid.Row="4" Content="复制原始响应" Command="{Binding CopyCommand}" CommandParameter="raw"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                            Style="{DynamicResource App.ToolbarButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部：校验报告 -->
        <Border Grid.Row="2" Style="{DynamicResource App.CardBorder}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="校验报告" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
