<UserControl x:Class="LlamaLauncher.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="概览" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- 统计卡片 -->
            <UniformGrid Columns="5" Margin="0,0,0,14">
                <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="运行中实例" Style="{DynamicResource App.CaptionText}" />
                        <TextBlock Text="{Binding RunningInstances}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="已停止实例" Style="{DynamicResource App.CaptionText}" />
                        <TextBlock Text="{Binding StoppedInstances}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="失败/异常" Style="{DynamicResource App.CaptionText}" />
                        <TextBlock Text="{Binding FailedInstances}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="已登记模型" Style="{DynamicResource App.CaptionText}" />
                        <TextBlock Text="{Binding ModelCount}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource App.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="默认 llama.cpp" Style="{DynamicResource App.CaptionText}" />
                        <TextBlock Text="{Binding DefaultVersionLabel}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 资源与版本 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource App.CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="系统资源" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SystemCpuText, StringFormat=CPU 使用率：{0}}" />
                        <TextBlock Text="{Binding SystemMemoryText, StringFormat=内存占用：{0}}" />
                        <TextBlock Text="{Binding GpuText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SampleTimeText}" Style="{DynamicResource App.CaptionText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{DynamicResource App.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="当前 llama.cpp 程序" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DefaultVersionPath}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DefaultVersionBackends, StringFormat=探测到的后端：{0}}" Margin="0,4,0,0" />
                        <Button Content="前往版本管理"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Command="{Binding OpenInstancesCommand}"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 活动实例 -->
            <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="实例状态" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding ActiveInstances}" MaxHeight="280" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*" />
                            <DataGridTextColumn Header="模型" Binding="{Binding ModelName}" Width="1.2*" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="90" />
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60" />
                            <DataGridTextColumn Header="运行时长" Binding="{Binding UptimeText}" Width="120" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="70" />
                            <DataGridTextColumn Header="内存" Binding="{Binding MemoryText}" Width="90" />
                            <DataGridTextColumn Header="健康" Binding="{Binding HealthText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="提示：完整操作（启动/停止/API 测试等）请前往“服务实例”页面。"
                               Style="{DynamicResource App.CaptionText}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 最近模型与失败 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource App.CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="最近使用的模型" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding RecentModels}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding SizeText}" Margin="8,0,0,0" Foreground="{DynamicResource App.Text.Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{DynamicResource App.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="最近的启动失败" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding RecentFailures}" BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
