<UserControl
    x:Class="LlamaLauncher.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="SemiBold"
                Text="设置" />

            <!--  外观与行为  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="外观与行为" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="主题：" />
                        <ComboBox
                            Width="120"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding ThemeChoices}"
                            SelectedValue="{Binding Theme, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="关闭窗口时最小化到托盘"
                            IsChecked="{Binding CloseToTray}" />
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="启动时直接进入托盘"
                            IsChecked="{Binding StartMinimizedToTray}" />
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="开机自动启动"
                            IsChecked="{Binding StartWithWindows}" />
                    </WrapPanel>
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="退出应用时停止所有由本应用启动的服务（安全默认，避免产生孤儿进程）"
                        IsChecked="{Binding StopServicesOnExit}" />
                </StackPanel>
            </Border>

            <!--  数据目录  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="数据与目录" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="{Binding DataRootText, StringFormat=当前数据目录：{0}}"
                        TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding ChangeDataRootCommand}" Content="更改数据目录…" />
                        <Button
                            Command="{Binding TogglePortableModeCommand}"
                            Content="便携模式"
                            ToolTip="便携（默认）：所有文件保存在程序目录；关闭后改用 %AppData%\\LlamaLauncher（重启生效）" />
                        <Button Command="{Binding OpenDataFolderCommand}" Content="打开数据目录" />
                        <Button Command="{Binding OpenLogsFolderCommand}" Content="打开日志目录" />
                        <Button Command="{Binding OpenRuntimesFolderCommand}" Content="打开版本目录" />
                        <Button Command="{Binding OpenExportsFolderCommand}" Content="打开导出目录" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="数据库、日志、下载、版本目录、清单与备份默认全部保存在程序目录；自定义数据目录会写入程序目录的 LlamaLauncher.bootstrap.json，重启后生效。" />
                </StackPanel>
            </Border>

            <!--  路径设置  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="路径设置" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="可把 llama.cpp 版本、更新下载与模型目录放到其他磁盘；修改后点击底部“保存设置”立即生效，“恢复默认”回到数据目录下的默认路径。"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,6,0" Text="llama.cpp 版本目录" />
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel
                            Margin="6,0,0,0"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <Button Command="{Binding PickRuntimesDirectoryCommand}" Content="更改…" />
                            <Button Command="{Binding ResetRuntimesDirectoryCommand}" Content="恢复默认" />
                            <Button Command="{Binding OpenRuntimesFolderCommand}" Content="打开" />
                        </StackPanel>
                        <TextBox IsReadOnly="True" Text="{Binding RuntimesDirectoryText}" />
                    </DockPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="{Binding RuntimesDirectoryHint}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,0,0" Text="更新下载目录" />
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel
                            Margin="6,0,0,0"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <Button Command="{Binding PickDownloadsDirectoryCommand}" Content="更改…" />
                            <Button Command="{Binding ResetDownloadsDirectoryCommand}" Content="恢复默认" />
                            <Button Command="{Binding OpenDownloadsFolderCommand}" Content="打开" />
                        </StackPanel>
                        <TextBox IsReadOnly="True" Text="{Binding DownloadsDirectoryText}" />
                    </DockPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="{Binding DownloadsDirectoryHint}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,0,0" Text="模型目录" />
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel
                            Margin="6,0,0,0"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <Button Command="{Binding PickModelsDirectoryCommand}" Content="更改…" />
                            <Button Command="{Binding ResetModelsDirectoryCommand}" Content="恢复默认" />
                            <Button Command="{Binding OpenModelsFolderCommand}" Content="打开" />
                        </StackPanel>
                        <TextBox IsReadOnly="True" Text="{Binding ModelsDirectoryText}" />
                    </DockPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="{Binding ModelsDirectoryHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  资源与日志  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="资源监控与日志" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="采样间隔（秒）：" />
                        <TextBox Width="60" Text="{Binding ResourceIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="日志保留天数：" />
                        <TextBox Width="60" Text="{Binding LogRetentionText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="单文件上限（MB）：" />
                        <TextBox Width="60" Text="{Binding LogMaxSizeText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="轮转文件数：" />
                        <TextBox Width="60" Text="{Binding LogRotatedCountText, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  更新  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="llama.cpp 更新" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="通道：" />
                        <ComboBox
                            Width="120"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding ChannelChoices}"
                            SelectedValue="{Binding UpdateChannel, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="启动时自动检查更新"
                            IsChecked="{Binding AutoCheckUpdates}" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="检查间隔（小时）：" />
                        <TextBox Width="60" Text="{Binding UpdateIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="检查间隔同时约束启动时的自动检查（间隔内重启不会重复请求 GitHub）。"
                        TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="{Binding GitHubTokenStatus, StringFormat=GitHub 令牌：{0}}" />
                        <Button
                            Margin="12,0,6,0"
                            Command="{Binding SetGitHubTokenCommand}"
                            Content="设置 / 更新令牌" />
                        <Button
                            Command="{Binding DeleteGitHubTokenCommand}"
                            Content="删除令牌"
                            Style="{DynamicResource App.DestructiveButtonStyle}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="可选：令牌仅用于只读查询官方 Releases，把频率上限从未登录 60 次/小时提高到 5000 次/小时（数据未变化时 304 不计配额）；使用 Windows DPAPI（当前用户）加密存储，不写入日志、导出与诊断包。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  安全  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="API Key 与局域网安全" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding ApiKeyStatus, StringFormat=默认 API Key：{0}}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button
                            Command="{Binding SetApiKeyCommand}"
                            Content="设置 / 更新 API Key"
                            Style="{DynamicResource App.PrimaryButtonStyle}" />
                        <Button
                            Command="{Binding DeleteApiKeyCommand}"
                            Content="删除 API Key"
                            Style="{DynamicResource App.DestructiveButtonStyle}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="密钥使用 Windows DPAPI（当前用户）加密存储；日志、启动历史、导出配置与诊断包均不包含密钥明文。局域网监听需要在启动前额外确认，且 API Key 不提供传输加密。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  备份与恢复  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="数据备份与恢复" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button
                            Command="{Binding CreateBackupCommand}"
                            Content="立即备份"
                            Style="{DynamicResource App.PrimaryButtonStyle}" />
                        <Button Command="{Binding RestoreBackupCommand}" Content="恢复所选备份" />
                        <Button Command="{Binding OpenBackupsFolderCommand}" Content="打开备份目录" />
                        <Button Command="{Binding ExportDiagnosticsCommand}" Content="导出诊断包" />
                    </WrapPanel>
                    <ListBox
                        MaxHeight="150"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Backups}"
                        SelectedItem="{Binding SelectedBackup, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="170" Text="{Binding CreatedText}" />
                                    <TextBlock Width="90" Text="{Binding SizeText}" />
                                    <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="备份使用 SQLite 在线备份（事务一致）；恢复前会自动备份当前数据库，恢复失败会自动回滚。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  关于  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="关于" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding AppVersionText}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.SecondaryText}"
                        Text="{Binding AboutText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  操作  -->
            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Command="{Binding SaveCommand}"
                    Content="保存设置"
                    Style="{DynamicResource App.PrimaryButtonStyle}" />
                <Button Command="{Binding ResetToDefaultsCommand}" Content="恢复默认设置" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource App.CaptionText}"
                    Text="{Binding StatusText}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
