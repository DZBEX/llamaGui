<UserControl x:Class="LlamaLauncher.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="llama.cpp 版本管理" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />

            <!-- 当前版本 -->
            <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="当前默认版本" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentVersionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="更新通道：" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="140"
                                  ItemsSource="{Binding ChannelChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Channel, Mode=TwoWay}" />
                        <Button Content="检查更新" Command="{Binding CheckForUpdatesCommand}" Style="{DynamicResource App.PrimaryButtonStyle}" Margin="10,0,0,0" />
                        <Button Content="打开官方发布页" Command="{Binding OpenOfficialPageCommand}" />
                        <Button Content="导入本地压缩包…" Command="{Binding ImportLocalCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CheckStatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastCheckText}" Style="{DynamicResource App.CaptionText}" Margin="0,2,0,0" />
                    <TextBlock Style="{DynamicResource App.CaptionText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="自动更新只信任官方 ggml-org/llama.cpp 发布源；不提供后台静默覆盖。每个版本安装到独立目录，可切换与回滚。" />
                </StackPanel>
            </Border>

            <!-- 发行与资产 -->
            <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="发行版本与资产" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Releases}"
                                  SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                                  DisplayMemberPath="TagName" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource App.CaptionText}"
                                   Text="发布前请阅读下方说明" />
                    </Grid>

                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource App.Text.Secondary}"
                           Text="尚无发行列表：点击“检查更新”从官方源加载（需要联网）。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Releases.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                    <DataGrid ItemsSource="{Binding Assets}"
                              SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                              MaxHeight="240"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="资产文件" Binding="{Binding Name}" Width="2.4*" />
                            <DataGridTextColumn Header="后端" Binding="{Binding BackendText}" Width="140" />
                            <DataGridTextColumn Header="CUDA" Binding="{Binding CudaText}" Width="70" />
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" />
                            <DataGridTextColumn Header="推荐" Binding="{Binding RecommendedText}" Width="80" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="下载并安装所选资产"
                                Command="{Binding DownloadAndInstallCommand}"
                                Style="{DynamicResource App.PrimaryButtonStyle}" />
                        <Button Content="取消下载"
                                Command="{Binding CancelDownloadCommand}"
                                Style="{DynamicResource App.DestructiveButtonStyle}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <ProgressBar Margin="0,8,0,0"
                                 Value="{Binding DownloadFraction, Mode=OneWay}"
                                 Maximum="1"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                                 IsIndeterminate="{Binding DownloadFraction, Converter={StaticResource NullToBoolIndeterminate}}" />
                    <TextBlock Text="{Binding DownloadStatusText}"
                               Margin="0,6,0,0"
                               Style="{DynamicResource App.CaptionText}"
                               Visibility="{Binding DownloadStatusText, Converter={StaticResource NullOrEmptyToVisibility}}" />

                    <Expander Header="发行说明（Markdown 原文）" Margin="0,10,0,0">
                        <TextBox Text="{Binding ReleaseNotesPreview}"
                                 IsReadOnly="True"
                                 MaxHeight="220"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 已安装版本 -->
            <Border Style="{DynamicResource App.CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="已安装版本" FontWeight="SemiBold" />
                    <DataGrid ItemsSource="{Binding InstalledVersions}"
                              SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                              MaxHeight="240"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="默认" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="★" Foreground="{DynamicResource App.State.Loading}"
                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="100" />
                            <DataGridTextColumn Header="后端" Binding="{Binding BackendText}" Width="180" />
                            <DataGridTextColumn Header="校验" Binding="{Binding HashText}" Width="180" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90" />
                            <DataGridTextColumn Header="目录" Binding="{Binding Directory}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="设为默认" Command="{Binding SetDefaultCommand}" Style="{DynamicResource App.PrimaryButtonStyle}" />
                        <Button Content="回滚到上一默认版本" Command="{Binding RollbackCommand}" />
                        <Button Content="重新探测能力" Command="{Binding RefreshProbeCommand}" />
                        <Button Content="安装运行时辅助包…"
                                Command="{Binding InstallRuntimePackCommand}"
                                ToolTip="为所选 CUDA 版本补装官方 cudart 运行时 DLL（与主程序相同的校验与安全检查）" />
                        <Button Content="删除所选版本" Command="{Binding DeleteInstallationCommand}" Style="{DynamicResource App.DestructiveButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 更新历史 -->
            <Border Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock Text="更新操作历史" FontWeight="SemiBold" />
                    <DataGrid ItemsSource="{Binding History}" MaxHeight="220" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding StartedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110" />
                            <DataGridTextColumn Header="目标版本" Binding="{Binding ToVersion}" Width="110" />
                            <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="110" />
                            <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
