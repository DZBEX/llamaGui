<UserControl
    x:Class="LlamaLauncher.App.Views.UpdatesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LlamaLauncher.App.Controls">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="SemiBold"
                Text="llama.cpp 版本管理" />

            <!--  当前版本  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="当前默认版本" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="{Binding CurrentVersionText}"
                        TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="更新通道：" />
                        <ComboBox
                            Width="140"
                            Margin="0,0,6,0"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding ChannelChoices}"
                            SelectedValue="{Binding Channel, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <Button
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="检查更新"
                            Style="{DynamicResource App.PrimaryButtonStyle}" />
                        <Button Command="{Binding OpenOfficialPageCommand}" Content="打开官方发布页" />
                        <Button Command="{Binding ImportLocalCommand}" Content="导入本地压缩包…" />
                        <Button
                            Command="{Binding ScanLocalVersionsCommand}"
                            Content="扫描本地版本"
                            ToolTip="扫描版本目录（runtimes\llama.cpp），把手动拷入的已解压版本登记到下方列表" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding CheckStatusText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="{Binding LastCheckText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="自动更新只信任官方 ggml-org/llama.cpp 发布源；不提供后台静默覆盖。每个版本安装到独立目录，可切换与回滚。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  发行与资产  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="发行版本与资产" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            DisplayMemberPath="TagName"
                            ItemsSource="{Binding Releases}"
                            SelectedItem="{Binding SelectedRelease, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource App.CaptionText}"
                            Text="发布前请阅读下方说明" />
                    </Grid>

                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource App.Text.Secondary}"
                        Text="尚无发行列表：点击“检查更新”从官方源加载（需要联网）。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Releases.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid
                        MaxHeight="240"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Assets}"
                        SelectedItem="{Binding SelectedAsset, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="2.4*"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="资产文件" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding BackendText}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="后端" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding CudaText}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="CUDA" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding SizeText}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="大小" />
                            <DataGridTemplateColumn Width="80" Header="推荐">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                            <controls:AppIcon
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource App.State.Loading}"
                                                Icon="star" />
                                            <TextBlock VerticalAlignment="Center" Text="推荐" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="1.6*"
                                Binding="{Binding Note}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="说明" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Margin="0,10,0,0">
                        <Button
                            Command="{Binding DownloadAndInstallCommand}"
                            Content="下载并安装所选资产"
                            Style="{DynamicResource App.PrimaryButtonStyle}" />
                        <Button
                            Command="{Binding CancelDownloadCommand}"
                            Content="取消下载"
                            Style="{DynamicResource App.DestructiveButtonStyle}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <ProgressBar
                        Margin="0,8,0,0"
                        IsIndeterminate="{Binding DownloadFraction, Converter={StaticResource NullToBoolIndeterminate}}"
                        Maximum="1"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                        Value="{Binding DownloadFraction, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource App.CaptionText}"
                        Text="{Binding DownloadStatusText}"
                        Visibility="{Binding DownloadStatusText, Converter={StaticResource NullOrEmptyToVisibility}}" />

                    <Expander Margin="0,10,0,0" Header="发行说明（Markdown 原文）">
                        <TextBox
                            MaxHeight="220"
                            FontSize="12"
                            IsReadOnly="True"
                            Text="{Binding ReleaseNotesPreview}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </Border>

            <!--  已安装版本  -->
            <Border Margin="0,0,0,12" Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="已安装版本" />
                    <DataGrid
                        MaxHeight="240"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding InstalledVersions}"
                        SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" Header="默认">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:AppIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource App.State.Loading}"
                                            Icon="star"
                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Version}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="版本" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding BackendText}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="后端" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding HashText}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="校验" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding StatusText}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="状态" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Directory}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="目录" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button
                            Command="{Binding SetDefaultCommand}"
                            Content="设为默认"
                            Style="{DynamicResource App.PrimaryButtonStyle}" />
                        <Button Command="{Binding RollbackCommand}" Content="回滚到上一默认版本" />
                        <Button Command="{Binding RefreshProbeCommand}" Content="重新探测能力" />
                        <Button
                            Command="{Binding InstallRuntimePackCommand}"
                            Content="安装运行时辅助包…"
                            ToolTip="为所选 CUDA 版本补装官方 cudart 运行时 DLL（与主程序相同的校验与安全检查）" />
                        <Button
                            Command="{Binding DeleteInstallationCommand}"
                            Content="删除所选版本"
                            Style="{DynamicResource App.DestructiveButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  更新历史  -->
            <Border Style="{DynamicResource App.CardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="更新操作历史" />
                    <DataGrid
                        MaxHeight="220"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding StartedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="时间" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Kind}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="类型" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding ToVersion}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="目标版本" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Stage}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="阶段" />
                            <DataGridTextColumn
                                Width="2.4*"
                                Binding="{Binding Error}"
                                ElementStyle="{StaticResource App.CellText}"
                                Header="错误" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
