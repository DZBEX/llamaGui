<UserControl x:Class="LlamaLauncher.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="启动历史" FontSize="20" FontWeight="SemiBold" />

        <WrapPanel Grid.Row="1" Margin="0,10,0,8">
            <TextBlock Text="实例筛选：" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="180" Text="{Binding InstanceFilterText, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="只看失败/异常" IsChecked="{Binding OnlyFailures}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="12,0,0,0" Style="{DynamicResource App.PrimaryButtonStyle}" />
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="启动时间" Binding="{Binding StartedText}" Width="150" />
                <DataGridTextColumn Header="实例" Binding="{Binding InstanceName}" Width="140" />
                <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="70" />
                <DataGridTextColumn Header="结束时间" Binding="{Binding EndedText}" Width="150" />
                <DataGridTextColumn Header="退出码" Binding="{Binding ExitCodeText}" Width="70" />
                <DataGridTextColumn Header="最终状态" Binding="{Binding FinalStateText}" Width="100" />
                <DataGridTextColumn Header="失败阶段" Binding="{Binding FailureStageText}" Width="110" />
                <DataGridTextColumn Header="错误摘要" Binding="{Binding ErrorText}" Width="2.4*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="暂无启动记录。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource App.Text.Secondary}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="3" Style="{DynamicResource App.CardBorder}" Margin="0,10,0,0" MaxHeight="260">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="记录详情" FontWeight="SemiBold" />
                    <TextBlock Text="命令行（脱敏）" Margin="0,6,0,2" Style="{DynamicResource App.CaptionText}" />
                    <TextBox Text="{Binding DetailMaskedCommand, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" MaxHeight="80"
                             VerticalScrollBarVisibility="Auto" />
                    <Button Content="复制命令行" Command="{Binding CopyCommandCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{DynamicResource App.ToolbarButtonStyle}" />
                    <TextBlock Text="{Binding DetailError}" Foreground="{DynamicResource App.State.Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding DetailError, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Text="模型快照" Margin="0,6,0,2" Style="{DynamicResource App.CaptionText}"
                               Visibility="{Binding DetailModelSnapshot, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBox Text="{Binding DetailModelSnapshot, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" MaxHeight="70"
                             Visibility="{Binding DetailModelSnapshot, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="打开本次日志文件" Command="{Binding OpenLogFileCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <TextBlock Text="{Binding DetailLogFilePath}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Style="{DynamicResource App.CaptionText}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
