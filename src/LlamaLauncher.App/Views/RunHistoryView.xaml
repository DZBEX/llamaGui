<UserControl x:Class="LlamaLauncher.App.Views.RunHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource App.CardBorder}" Padding="8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="工作流" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="170" ItemsSource="{Binding WorkflowChoices}"
                          SelectedItem="{Binding FilterWorkflow, Mode=TwoWay}"
                          DisplayMemberPath="Name" VerticalAlignment="Center" />
                <Button Content="全部" Command="{Binding RefreshCommand}" CommandParameter="" Style="{DynamicResource App.ToolbarButtonStyle}"
                        Click="OnClearWorkflowFilter" />
                <TextBlock Text="状态" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox Width="120" ItemsSource="{Binding StateFilters}"
                          SelectedItem="{Binding StateFilter, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBox Width="170" Margin="10,0,0,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按名称 / RunId / 错误摘要搜索" />
                <Button Content="查询" Command="{Binding RefreshCommand}" Margin="6,0,0,0" Style="{DynamicResource App.PrimaryButtonStyle}" />
                <Rectangle Width="1" Margin="8,2" Fill="{DynamicResource App.Border}" />
                <Button Content="比较选中两条" Command="{Binding CompareCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                <Button Content="复制为新用例" Command="{Binding CopyAsTestCaseCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                <Button Content="导出诊断…" Command="{Binding ExportDiagnosticsCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                <Button Content="删除" Command="{Binding DeleteRunCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                <Button Content="按保留策略清理…" Command="{Binding PruneCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource App.CardBorder}">
                <ListBox x:Name="RunList"
                         ItemsSource="{Binding Runs}"
                         SelectionMode="Extended"
                         SelectionChanged="OnRunSelectionChanged"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding State, Converter={StaticResource RunStateGlyph}}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding WorkflowNameSnapshot}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StartedUtc, StringFormat={}{0:MM-dd HH:mm:ss}, ConverterCulture=zh-CN}"
                                               Margin="8,0,0,0" Style="{DynamicResource App.SecondaryText}" />
                                </StackPanel>
                                <TextBlock FontSize="11" Style="{DynamicResource App.CaptionText}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding RunId, Mode=OneWay}" />
                                    <Run Text="{Binding DurationMs, StringFormat= · {0:0} ms, Mode=OneWay}" />
                                    <Run Text="{Binding ErrorSummary, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource App.CardBorder}">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="详情">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailSummaryText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="复制摘要" Command="{Binding CopyDetailCommand}" CommandParameter="summary" Style="{DynamicResource App.ToolbarButtonStyle}" />
                                    <Button Content="复制输入" Command="{Binding CopyDetailCommand}" CommandParameter="input" Style="{DynamicResource App.ToolbarButtonStyle}" />
                                    <Button Content="复制输出" Command="{Binding CopyDetailCommand}" CommandParameter="output" Style="{DynamicResource App.ToolbarButtonStyle}" />
                                    <Button Content="复制变量" Command="{Binding CopyDetailCommand}" CommandParameter="variables" Style="{DynamicResource App.ToolbarButtonStyle}" />
                                </StackPanel>
                                <TextBlock Text="节点运行" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <DataGrid ItemsSource="{Binding DetailNodes}" MinHeight="140" MaxHeight="240"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="节点" Binding="{Binding Name}" Width="150" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="110" />
                                        <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="80" />
                                        <DataGridTextColumn Header="重试" Binding="{Binding Retries}" Width="48" />
                                        <DataGridTextColumn Header="分支" Binding="{Binding Branch}" Width="96" />
                                        <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="220" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="输入快照" Margin="0,8,0,2" />
                                <TextBox Text="{Binding DetailInput}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="50" MaxHeight="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="输出" Margin="0,8,0,2" />
                                <TextBox Text="{Binding DetailOutput}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="50" MaxHeight="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="最终变量" Margin="0,8,0,2" />
                                <TextBox Text="{Binding DetailVariables}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="40" MaxHeight="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="模型上下文（非敏感）" Margin="0,8,0,2" />
                                <TextBox Text="{Binding DetailModelContext}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="40" MaxHeight="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="日志" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <ListBox ItemsSource="{Binding DetailLogs}" MaxHeight="240" ItemContainerStyle="{DynamicResource App.LogLineStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                                                <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource App.Text.Secondary}" />
                                                <Run Text=" [" Foreground="{DynamicResource App.Text.Secondary}" />
                                                <Run Text="{Binding LevelText, Mode=OneWay}" />
                                                <Run Text="] " Foreground="{DynamicResource App.Text.Secondary}" />
                                                <Run Text="{Binding Message, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="对比">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding ComparisonSummaryText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ComparisonNotes}" Margin="0,6,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{DynamicResource App.SecondaryText}" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding ComparisonChanges}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="类型" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Kind}" Foreground="{Binding Kind, Converter={StaticResource DiffKindToBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="字段路径" Binding="{Binding Path}" Width="220" />
                                    <DataGridTextColumn Header="旧值" Binding="{Binding OldValue}" Width="260" />
                                    <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
