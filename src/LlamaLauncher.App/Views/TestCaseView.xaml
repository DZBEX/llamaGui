<UserControl x:Class="LlamaLauncher.App.Views.TestCaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LlamaLauncher.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 用例列表 -->
        <Border Grid.Column="0" Style="{DynamicResource App.CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="测试用例" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
                    <Button Content="新建" Command="{Binding NewCaseCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Cases}"
                         SelectedItem="{Binding SelectedCase, Mode=TwoWay}"
                         DisplayMemberPath="Name" />
                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="复制" Command="{Binding DuplicateCaseCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="删除" Command="{Binding DeleteCaseCommand}" Style="{DynamicResource App.DestructiveButtonStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="导入…" Command="{Binding ImportCaseCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        <Button Content="导出…" Command="{Binding ExportCaseCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 编辑器 -->
        <Border Grid.Column="2" Style="{DynamicResource App.CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EditorStatusText}" Style="{DynamicResource App.CaptionText}" />
                </WrapPanel>

                <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                    <Button Content="保存用例" Command="{Binding SaveCaseCommand}" Style="{DynamicResource App.PrimaryButtonStyle}" />
                    <Button Command="{Binding RunCaseCommand}" Margin="6,0,0,0"
                            AutomationProperties.Name="运行用例"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Icon="state-play" Width="12" Height="12" Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="运行用例" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding RunResultText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap" />
                </WrapPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="名称" />
                                <TextBox Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="标签（逗号分隔）" />
                                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="说明" Margin="0,6,0,0" />
                        <TextBox Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="36" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="绑定工作流" />
                                <ComboBox ItemsSource="{Binding WorkflowChoices}"
                                          SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="版本快照（可空）" />
                                <TextBox Text="{Binding VersionLabelText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="模式" />
                                <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,10,0,4">
                            <TextBlock Text="输入（JSON，工作流输入变量）" FontWeight="SemiBold" />
                            <Button Content="生成模板" Command="{Binding GenerateInputsTemplateCommand}" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right" Style="{DynamicResource App.ToolbarButtonStyle}" />
                        </DockPanel>
                        <TextBox Text="{Binding InputsJson, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" MinHeight="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                        <DockPanel Margin="0,12,0,4">
                            <TextBlock Text="模拟响应（模拟模式使用；节点 ID → 固定输出）" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="添加" Command="{Binding AddMockCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                                <Button Content="删除选中" Command="{Binding RemoveMockCommand}" CommandParameter="{Binding SelectedItem, ElementName=MockGrid}"
                                        Style="{DynamicResource App.ToolbarButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="MockGrid" ItemsSource="{Binding Mocks}" MinHeight="110" MaxHeight="200"
                                  CanUserAddRows="False" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="节点 ID" Binding="{Binding NodeId, UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource App.CellText}" />
                                <DataGridTextColumn Header="输出（JSON）" Binding="{Binding OutputJson, UpdateSourceTrigger=PropertyChanged}" Width="400" ElementStyle="{StaticResource App.CellText}" />
                                <DataGridTextColumn Header="分支（可空）" Binding="{Binding BranchId, UpdateSourceTrigger=PropertyChanged}" Width="120" ElementStyle="{StaticResource App.CellText}" />
                                <DataGridTextColumn Header="模拟错误（可空）" Binding="{Binding ErrorMessage, UpdateSourceTrigger=PropertyChanged}" Width="240" ElementStyle="{StaticResource App.CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Margin="0,12,0,4">
                            <TextBlock Text="断言（实际结果 vs 期望）" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="添加" Command="{Binding AddAssertionCommand}" Style="{DynamicResource App.ToolbarButtonStyle}" />
                                <Button Content="删除选中" Command="{Binding RemoveAssertionCommand}" CommandParameter="{Binding SelectedItem, ElementName=AssertionGrid}"
                                        Style="{DynamicResource App.ToolbarButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="AssertionGrid" ItemsSource="{Binding Assertions}" MinHeight="120" MaxHeight="220"
                                  CanUserAddRows="False" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="130" ElementStyle="{StaticResource App.CellText}" />
                                <DataGridTextColumn Header="目标表达式" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="230" ElementStyle="{StaticResource App.CellText}" />
                                <DataGridTemplateColumn Header="运算符" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.OperatorOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding Operator, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="期望值（JSON）" Binding="{Binding ExpectedJson, UpdateSourceTrigger=PropertyChanged}" Width="200" ElementStyle="{StaticResource App.CellText}" />
                                <DataGridTextColumn Header="容差" Binding="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}" Width="60" ElementStyle="{StaticResource App.CellText}" />
                                <DataGridTemplateColumn Header="级别" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SeverityOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding Severity, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="差异比较时忽略的字段（逗号分隔，例如 time.id）" Margin="0,10,0,0" />
                        <TextBox Text="{Binding IgnoreFieldsText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="断言结果" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding RunOutcomes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <controls:AppIcon Margin="0,0,6,0" Width="14" Height="14" VerticalAlignment="Center">
                                            <controls:AppIcon.Style>
                                                <Style TargetType="controls:AppIcon">
                                                    <Setter Property="Icon" Value="state-error" />
                                                    <Setter Property="Fill" Value="{DynamicResource App.State.Error}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                                            <Setter Property="Icon" Value="state-check" />
                                                            <Setter Property="Fill" Value="{DynamicResource App.State.Ready}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Passed}" Value="False" />
                                                                <Condition Binding="{Binding IsFailure}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Icon" Value="warn" />
                                                            <Setter Property="Fill" Value="{DynamicResource App.State.Loading}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:AppIcon.Style>
                                        </controls:AppIcon>
                                        <TextBlock Text="{Binding Name}" Width="180" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{DynamicResource App.SecondaryText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
