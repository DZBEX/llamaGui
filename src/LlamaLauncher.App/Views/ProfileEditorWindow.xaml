<Window x:Class="LlamaLauncher.App.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑启动配置"
        Height="760" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Window.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 能力摘要 -->
        <Border Grid.Row="0"
                Padding="10,6"
                CornerRadius="6"
                Background="{DynamicResource App.Surface.Alt}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1">
            <TextBlock Text="{Binding CapabilitySummary}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="配置名称" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,12,4"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="模型" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,4,0,4"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="llama.cpp 程序" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,12,4"
                              ItemsSource="{Binding AvailableInstallations}"
                              SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                              DisplayMemberPath="VersionLabel" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="模型别名（--alias）" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,4,0,4" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="备注" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,4"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Separator />
                <TextBlock Text="网络" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="监听地址（--host）" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,12,4" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="端口（--port）" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,4,0,4" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="访问范围提示" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                               Style="{DynamicResource App.CaptionText}"
                               VerticalAlignment="Center"
                               Text="默认 127.0.0.1 仅本机可访问；修改为 0.0.0.0/局域网 IP 属于高风险操作，启动前需要确认，并且要求已配置 API Key。" />
                </Grid>

                <Separator />
                <TextBlock Text="性能参数" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="上下文长度 (-c)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,12,4"
                             IsEnabled="{Binding SupportsCtxSize}"
                             Text="{Binding ContextSizeText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="GPU 层数 (-ngl)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,4,0,4"
                             IsEnabled="{Binding SupportsGpuLayers}"
                             Text="{Binding GpuLayersText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="可填整数；当前版本支持时也可填 auto/all" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU 线程 (-t)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,12,4"
                             IsEnabled="{Binding SupportsThreads}"
                             Text="{Binding ThreadsText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="批处理线程 (-tb)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,4,0,4"
                             IsEnabled="{Binding SupportsThreads}"
                             Text="{Binding ThreadsBatchText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="批大小 (-b)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,12,4"
                             IsEnabled="{Binding SupportsBatch}"
                             Text="{Binding BatchSizeText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="物理批大小 (-ub)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="0,4,0,4"
                             IsEnabled="{Binding SupportsBatch}"
                             Text="{Binding UBatchSizeText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="设备 (--device)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,12,4"
                             IsEnabled="{Binding SupportsDevices}"
                             Text="{Binding DevicesText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="多个设备用逗号分隔，例如 CUDA0, CUDA1" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="分割模式 (-sm)" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="3" Margin="0,4,0,4"
                              ItemsSource="{Binding SplitModeChoices}"
                              SelectedItem="{Binding SplitMode, Mode=TwoWay}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="张量分割 (-ts)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4,12,4"
                             Text="{Binding TensorSplitText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如 3,1" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="主 GPU (-mg)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="3" Margin="0,4,0,4"
                             Text="{Binding MainGpuText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="KV cache K/V (-ctk/-ctv)" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4,12,4" IsEnabled="{Binding SupportsKvCache}">
                        <ComboBox Width="120" ItemsSource="{Binding CacheTypeChoices}" SelectedItem="{Binding CacheTypeK, Mode=TwoWay}" />
                        <ComboBox Width="120" Margin="6,0,0,0" ItemsSource="{Binding CacheTypeChoices}" SelectedItem="{Binding CacheTypeV, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Flash Attention (-fa)" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="5" Grid.Column="3" Margin="0,4,0,4"
                              IsEnabled="{Binding SupportsFlashAttention}"
                              ItemsSource="{Binding FlashAttentionChoices}"
                              SelectedItem="{Binding FlashAttention, Mode=TwoWay}" />
                </Grid>

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="并行槽位 (-np)" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="80" Text="{Binding ParallelText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SupportsParallel}" />
                    <TextBlock Text="连续批处理" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <ComboBox Width="150" ItemsSource="{Binding TriStateChoices}" SelectedItem="{Binding ContinuousBatching, Mode=TwoWay}" IsEnabled="{Binding SupportsContBatching}" />
                    <CheckBox Content="详细日志 (-v)" IsChecked="{Binding VerboseLogging}" Margin="16,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding SupportsVerbose}" />
                    <CheckBox Content="禁用内存映射 (--no-mmap)" IsChecked="{Binding NoMemoryMap}" Margin="16,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding SupportsNoMmap}" />
                </WrapPanel>

                <Separator />
                <TextBlock Text="预设" FontWeight="SemiBold" Margin="0,0,0,4" />
                <WrapPanel>
                    <Button Content="CPU 兼容预设" Command="{Binding ApplyCpuPresetCommand}" />
                    <Button Content="GPU 自动预设" Command="{Binding ApplyGpuAutoPresetCommand}" />
                </WrapPanel>

                <Separator />
                <TextBlock Text="API Key 与超时" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0"
                              Content="启用 API Key"
                              IsChecked="{Binding ApiKeyEnabled}"
                              IsEnabled="{Binding SupportsApiKey}"
                              VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,12,4"
                             IsEnabled="{Binding ApiKeyEnabled}"
                             Text="{Binding ApiKeySecretName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="密钥存储中的名称（密钥本体在“设置”页配置，不会写入本文件）" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="启动超时（秒）" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,4,0,4"
                             Text="{Binding StartupTimeoutText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="停止宽限期（秒）" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,12,4"
                             Text="{Binding StopGraceText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Separator />
                <TextBlock Text="高级：额外参数与环境变量" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="52"
                         FontFamily="Consolas"
                         ToolTip="按 Windows 命令行规则解析；与上方 UI 管理的参数冲突时会阻止保存（除非允许覆盖）" />
                <CheckBox Content="允许高级参数覆盖 UI 管理的关键参数（执行时以高级参数为准）"
                          IsChecked="{Binding AllowOverride}"
                          Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBlock Text="环境变量" VerticalAlignment="Center" />
                    <Button Content="添加" Command="{Binding AddEnvironmentVariableCommand}" Margin="10,0,0,0" Style="{DynamicResource App.ToolbarButtonStyle}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBox Width="220" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="280" Margin="6,0,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="移除" Margin="6,0,0,0"
                                        Style="{DynamicResource App.ToolbarButtonStyle}"
                                        Command="{Binding DataContext.RemoveEnvironmentVariableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 校验与预览 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="校验并预览" Command="{Binding ValidateAndPreviewCommand}" Style="{DynamicResource App.PrimaryButtonStyle}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,6,0,0" MaxHeight="120">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding Converter={StaticResource SeverityToBrush}}"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="命令预览（脱敏）" FontWeight="SemiBold" />
                <TextBox Text="{Binding CommandPreview, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11.5"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" MinWidth="96" Command="{Binding CancelCommand}" />
            <Button Content="保存配置" MinWidth="120" Command="{Binding SaveCommand}" Style="{DynamicResource App.PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
