<UserControl x:Class="LlamaLauncher.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="启动配置" FontSize="20" FontWeight="SemiBold" />

        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
            <Button Content="新建配置" Command="{Binding CreateCommand}" Style="{DynamicResource App.PrimaryButtonStyle}" />
            <Button Content="编辑" Command="{Binding EditCommand}" />
            <Button Content="复制" Command="{Binding DuplicateCommand}" />
            <Button Content="设为默认" Command="{Binding SetDefaultCommand}" />
            <Button Content="删除" Command="{Binding DeleteCommand}" Style="{DynamicResource App.DestructiveButtonStyle}" />
            <Button Content="导出 JSON" Command="{Binding ExportCommand}" />
            <Button Content="导入 JSON" Command="{Binding ImportCommand}" />
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="默认" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="★"
                                       FontSize="14"
                                       Foreground="{DynamicResource App.State.Loading}"
                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.6*" />
                <DataGridTextColumn Header="模型" Binding="{Binding ModelName}" Width="1.6*" />
                <DataGridTextColumn Header="程序版本" Binding="{Binding VersionLabel}" Width="110" />
                <DataGridTextColumn Header="监听" Binding="{Binding EndpointText}" Width="140" />
                <DataGridTextColumn Header="访问范围" Binding="{Binding ScopeText}" Width="100" />
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedText}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="暂无配置档案，点击“新建配置”创建。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource App.Text.Secondary}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Style="{DynamicResource App.CaptionText}"
                   TextWrapping="Wrap"
                   Text="提示：编辑配置时会先按当前 llama.cpp 版本的能力快照校验参数；不支持的关键参数会阻止保存/启动，不会被静默忽略。" />
    </Grid>
</UserControl>
