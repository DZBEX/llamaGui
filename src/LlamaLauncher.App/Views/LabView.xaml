<UserControl
    x:Class="LlamaLauncher.App.Views.LabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LlamaLauncher.App.Controls"
    xmlns:views="clr-namespace:LlamaLauncher.App.Views"
    xmlns:vm="clr-namespace:LlamaLauncher.App.ViewModels.Lab">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题已由左侧主导航承载，这里直接显示子页导航。  -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox
                Grid.Column="0"
                Margin="0,0,12,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Tabs}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedItem="{Binding CurrentTab, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="Root"
                                        Margin="0,0,3,0"
                                        Padding="9,5"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                Icon="{Binding Icon}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                Text="{Binding Title}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.Surface.Alt}" />
                                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock
                Grid.Column="1"
                MaxWidth="360"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{DynamicResource App.CaptionText}"
                Text="{Binding CurrentTab.Description}"
                TextAlignment="Right"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding CurrentTab.Description}" />
        </Grid>

        <ContentControl
            Grid.Row="1"
            Content="{Binding CurrentPage}"
            ContentTemplateSelector="{StaticResource LabPageTemplateSelector}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:ModelDebugViewModel}">
                    <views:ModelDebugView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:WorkflowDesignerViewModel}">
                    <views:WorkflowDesignerView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:TestCaseViewModel}">
                    <views:TestCaseView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:BatchTestViewModel}">
                    <views:BatchTestView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:GameLabViewModel}">
                    <views:GameLabView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RunHistoryViewModel}">
                    <views:RunHistoryView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</UserControl>
